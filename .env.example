# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — it holds real passwords, never commit it.
#
# When deploying: add these same four sections in the Vercel
# dashboard under Settings -> Environment Variables.
# ---------------------------------------------------------------

# 1. DATABASE — Neon dashboard -> your project -> Connection string
#    Use the "Pooled connection" string.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. AUTH — NEXTAUTH_SECRET signs the login cookie.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    NEXTAUTH_URL is the site's own address. On Vercel, set it to the
#    real domain (https://yoursite.vercel.app), not localhost.
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# 3. ADMIN LOGIN — the only account this site has.
#    ADMIN_PASSWORD_HASH is a bcrypt hash, never the password itself.
#    Generate it with:  npm run hash-password -- "your-password"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="replace-with-output-of-npm-run-hash-password"

# 4. IMAGE STORAGE — Vercel dashboard -> Storage -> Blob -> create a store,
#    then copy the token from its .env.local tab.
#    Without this, everything works except uploading photos.
BLOB_READ_WRITE_TOKEN="replace-with-blob-token"
